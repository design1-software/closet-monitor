# Copy this file to .env and fill in your values
MQTT_HOST=10.0.0.14
MQTT_PORT=1883
MQTT_TOPIC=home/closet/#
DB_PATH=../data/closet.db
MQTT_USER=your-mqtt-username
MQTT_PASSWORD='your-mqtt-password'
# NTFY_URL: use the public service (https://ntfy.sh) OR point at a self-hosted
# ntfy hub to route alerts into a unified home-lab notification channel, e.g.
#   NTFY_URL=https://ntfy.example.ts.net   (self-hosted, e.g. behind Tailscale Serve)
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=your-ntfy-topic
